{
    "configurations": [
        {
            "name": "ZMK",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/build/zephyr/include/generated/**",
                "${workspaceFolder}/zmk/app/include/**",
                "${workspaceFolder}/zmk/app/dts/**",
                "${workspaceFolder}/zephyr/include/**",
                "${workspaceFolder}/zephyr/lib/libc/minimal/include/**"
            ],
            "defines": [
                "CONFIG_ZMK_KEYBOARD_NAME=\"Skinner47\""
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "gnu++14",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}